# Copy this file to .env and fill in your real values
# .env is never uploaded to GitHub

# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ── Claude AI ─────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key_here

# ── Gmail (daily briefing) ────────────────────────────────────────────────────
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# ── WordPress / WooCommerce maintenance ───────────────────────────────────────
# Your site URL (no trailing slash)
WP_URL=https://example.com

# WordPress admin credentials
# Use an Application Password: WP Admin > Users > Your Profile > Application Passwords
WP_USERNAME=your_wp_admin_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# SSH access for WP-CLI (enables plugin updates, security config checks)
# Leave blank if you do not have SSH access to the server
WP_SSH_HOST=example.com
WP_SSH_USER=ubuntu
WP_SSH_KEY_PATH=/home/kingseb/.ssh/id_rsa
WP_CLI_PATH=wp

# WPScan API token for vulnerability scanning (free tier: 25 requests/day)
# Get one at https://wpscan.com/api
WPSCAN_API_TOKEN=your_wpscan_token_here
